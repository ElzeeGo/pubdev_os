# Local Docker
# Another project may already own the default Supabase ports, so this app uses 55321+.
#   pnpm db:start     # Postgres, Auth, Studio, Mailpit in Docker
#   pnpm db:seed      # local.dev@example.test / local-dev-password
#   pnpm dev
# Studio:  http://127.0.0.1:55323
# Mailpit: http://127.0.0.1:55324
# The anon and service-role values below are Supabase's public local-demo JWTs.
# They only authenticate against a locally started stack.
#
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Get these from your Supabase project settings (https://app.supabase.com)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Services
# OpenAI API key for GPT content generation (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key

# ElevenLabs API key for video generation (https://elevenlabs.io/app/settings/api-keys)
# Seedance 2.5 is the default model. MiniMax H3 Max is the faster option.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Google Gemini API key for image/video generation (https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key

# X (Twitter) OAuth 2.0
# Create an app at https://developer.twitter.com/en/portal/dashboard
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# X (Twitter) OAuth 1.0a (for media upload)
# Use the same app credentials from your X Developer account
X_OAUTH1A_API_KEY=your_x_oauth1a_api_key
X_OAUTH1A_API_SECRET=your_x_oauth1a_api_secret

# Stripe (for payment processing)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Optional: Vercel KV (for caching)
# Only needed if using Vercel KV for Redis caching
# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token

